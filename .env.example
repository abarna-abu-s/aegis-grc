# Copy to .env and set real values. Never commit .env.
APP_ENV=development
DATABASE_URL=sqlite:///./aegis_demo.db
# Required in production (32+ chars). If unset in development a random per-process secret is used.
JWT_SECRET=
POSTGRES_PASSWORD=change_me
ACCESS_TOKEN_MINUTES=120
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=
ALLOW_REGISTRATION=true
# AI (optional). With AI_PROVIDER=none the copilot uses deterministic retrieval.
AI_PROVIDER=none
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
